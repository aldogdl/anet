{% extends 'base.html.twig' %}

{% block title %}Asistencia y Presencia YonkerosMX{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Presencia YonkerosMX</h1>
            <p class="text-sm text-slate-500 mt-1">Monitoreo de actividad del {{ periodStart }} al {{ periodEnd }} (15 días)</p>
        </div>
        <div class="flex items-center space-x-4 text-xs">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 font-medium border border-emerald-200">
                <span class="text-base font-bold leading-none">✓</span> Con acceso (última hora)
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-rose-50 text-rose-700 font-medium border border-rose-200">
                <span class="text-base font-bold leading-none">✕</span> Sin actividad
            </span>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-center border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-100/80 text-slate-700 font-semibold border-b border-slate-200 uppercase tracking-wider text-[11px]">
                        <th class="py-3 px-3 text-left sticky left-0 bg-slate-100 z-10 w-44 shadow-[1px_0_0_0_#e2e8f0]">Empresa</th>
                        <th class="py-3 px-3 text-left w-36 border-r border-slate-200">Usuario</th>
                        {% for day in days %}
                            <th class="py-2.5 px-2 border-r border-slate-200 last:border-r-0 min-w-[58px]">
                                {{ day.label }}
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for row in rows %}
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-2.5 px-3 text-left font-medium text-slate-800 sticky left-0 bg-white hover:bg-slate-50/70 z-10 shadow-[1px_0_0_0_#e2e8f0] truncate max-w-[176px]" title="{{ row.empresa }}">
                                {{ row.empresa }}
                            </td>
                            <td class="py-2.5 px-3 text-left font-mono text-slate-600 border-r border-slate-200 truncate max-w-[144px]" title="{{ row.usuario }}">
                                {{ row.usuario }}
                            </td>
                            {% for day in days %}
                                {% set act = row.attendance[day.key] ?? null %}
                                <td class="p-1 border border-slate-200/80 align-middle">
                                    {% if act %}
                                        <div class="h-12 w-full min-w-[50px] rounded bg-emerald-100/70 border border-emerald-300/80 flex flex-col items-center justify-center transition-transform hover:scale-[1.03]">
                                            <span class="text-emerald-800 font-extrabold text-sm leading-none">✓</span>
                                            <span class="text-[10px] font-mono font-semibold text-emerald-900 mt-1 leading-none">{{ act.time }}</span>
                                        </div>
                                    {% else %}
                                        <div class="h-12 w-full min-w-[50px] rounded bg-slate-100/70 border border-slate-200 flex items-center justify-center">
                                            <span class="text-slate-400 font-bold text-xs leading-none">✕</span>
                                        </div>
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ 2 + days|length }}" class="py-8 text-slate-400">
                                No se encontraron registros de presencia disponibles.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
